CREATE MEMORY TABLE PUBLIC.TBLDOG(FLDDOGID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDDOGNAME VARCHAR(50),FLDDOGAGE TINYINT,FLDDOGBREED VARCHAR(50),FLDDOGSPECIALNEEDS VARCHAR(1000),FLDDOGPREFERREDVET TINYINT,FLDDOGWEIGHT TINYINT,FLDDOGPENSIONDURATION TINYINT,FLDISDOGVACCINATED BOOLEAN,FLDISDOGTREATEDFORFLEAS BOOLEAN,FLDISDOGINSURED BOOLEAN,FLDDOGFOODTYPEID INTEGER,FLDFEEDAMOUNT DOUBLE,FLDDAILYFEEDTIMES INTEGER,FLDOWNERID INTEGER,FOREIGN KEY(FLDDOGFOODTYPEID) REFERENCES PUBLIC.TBLFOODTYPE(FLDFOODTYPEID))
ALTER TABLE PUBLIC.TBLDOG ALTER COLUMN FLDDOGID RESTART WITH 6
CREATE MEMORY TABLE PUBLIC.TBLOWNER(FLDOWNERID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDOWNERNAME VARCHAR(50),FLDOWNERPHONENO VARCHAR(20))
ALTER TABLE PUBLIC.TBLOWNER ALTER COLUMN FLDOWNERID RESTART WITH 12
CREATE MEMORY TABLE PUBLIC.TBLFEEDING(FLDFEEDINGDATETIME TIMESTAMP,TBLFEEDINGID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDDOGID INTEGER,FLDFOODTYPEID INTEGER,FOREIGN KEY(FLDDOGID) REFERENCES PUBLIC.TBLDOG(FLDDOGID),FOREIGN KEY(FLDFOODTYPEID) REFERENCES PUBLIC.TBLFOODTYPE(FLDFOODTYPEID))
ALTER TABLE PUBLIC.TBLFEEDING ALTER COLUMN TBLFEEDINGID RESTART WITH 6
CREATE MEMORY TABLE PUBLIC.TBLINCIDENT(FLDINCIDENTID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDDOGID INTEGER NOT NULL,FLDINCIDENTLOG VARCHAR(1000),FOREIGN KEY(FLDDOGID) REFERENCES PUBLIC.TBLDOG(FLDDOGID))
ALTER TABLE PUBLIC.TBLINCIDENT ALTER COLUMN FLDINCIDENTID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.TBLVETVISIT(FLDDOGID INTEGER NOT NULL,FLDVETID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDREASON VARCHAR(50),FLDDATETIME TIMESTAMP,FOREIGN KEY(FLDDOGID) REFERENCES PUBLIC.TBLDOG(FLDDOGID))
ALTER TABLE PUBLIC.TBLVETVISIT ALTER COLUMN FLDVETID RESTART WITH 0
CREATE MEMORY TABLE PUBLIC.TBLWALK(FLDWALKID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDDISTANCE DOUBLE,FLDDATETIME TIMESTAMP,FLDDOGID INTEGER,FOREIGN KEY(FLDDOGID) REFERENCES PUBLIC.TBLDOG(FLDDOGID))
