CREATE MEMORY TABLE PUBLIC.TBLFOODTYPE(FLDFOODTYPEID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FLDFOODTYPENAME VARCHAR(50))
