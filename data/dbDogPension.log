/*C5*/SET SCHEMA PUBLIC
    CREATE TABLE IF NOT EXISTS tblFoodType (\u000a        fldFoodTypeID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldFoodTypeName VARCHAR(50)\u000a    )\u000a
    CREATE TABLE IF NOT EXISTS tblDog (\u000a        fldDogID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldDogName VARCHAR(50),\u000a        fldDogAge TINYINT,\u000a        fldDogBreed VARCHAR(50),\u000a        fldDogSpecialNeeds VARCHAR(1000),\u000a        fldDogPreferredVet TINYINT,\u000a        fldDogWeight TINYINT,\u000a        fldDogPensionDuration TINYINT,\u000a        fldIsDogVaccinated BOOLEAN,\u000a        fldIsDogTreatedForFleas BOOLEAN,\u000a        fldIsDogInsured BOOLEAN,\u000a        fldDogFoodTypeID INTEGER,\u000a        fldFeedAmount DOUBLE,\u000a        fldDailyFeedTimes INTEGER,\u000a        fldOwnerID INTEGER,\u000a\u000a        FOREIGN KEY (fldDogFoodTypeID)\u000a            REFERENCES tblFoodType(fldFoodTypeID)\u000a    )\u000a
    CREATE TABLE IF NOT EXISTS tblOwner (\u000a        fldOwnerID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldOwnerName VARCHAR(50),\u000a        fldOwnerPhoneNo VARCHAR(20)\u000a    )\u000a
    CREATE TABLE IF NOT EXISTS tblFeeding (\u000a        fldFeedingDateTime TIMESTAMP,\u000a        tblFeedingID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldDogID INTEGER,\u000a        fldFoodTypeID INTEGER,\u000a\u000a        FOREIGN KEY (fldDogID)\u000a            REFERENCES tblDog(fldDogID),\u000a\u000a        FOREIGN KEY (fldFoodTypeID)\u000a            REFERENCES tblFoodType(fldFoodTypeID)\u000a    )\u000a
    CREATE TABLE IF NOT EXISTS tblIncident (\u000a        fldIncidentID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldDogID INTEGER NOT NULL,\u000a        fldIncidentLog VARCHAR(1000),\u000a\u000a        FOREIGN KEY (fldDogID)\u000a            REFERENCES tblDog(fldDogID)\u000a    )\u000a
    CREATE TABLE IF NOT EXISTS tblVetVisit (\u000a        fldDogID INTEGER NOT NULL,\u000a        fldVetID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldReason VARCHAR(50),\u000a        fldDateTime TIMESTAMP,\u000a\u000a        FOREIGN KEY (fldDogID)\u000a            REFERENCES tblDog(fldDogID)\u000a    )\u000a
    CREATE TABLE IF NOT EXISTS tblWalk (\u000a        fldWalkID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\u000a        fldDistance DOUBLE,\u000a        fldDateTime TIMESTAMP,\u000a        fldDogID INTEGER,\u000a\u000a        FOREIGN KEY (fldDogID)\u000a            REFERENCES tblDog(fldDogID)\u000a    )\u000a
DISCONNECT
